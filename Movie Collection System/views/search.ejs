<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Search Movies - MovieVault</title>
    <style>
        /* Base Reset & Typography */
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        
        body { 
            background-color: #0f172a; 
            color: #f8fafc; 
            min-height: 100vh; 
            display: flex; 
            flex-direction: column; 
            align-items: center; 
            padding: 20px; 
        }

        /* Header & Search Form Styling */
        header { text-align: center; margin: 3rem 0 2rem; }
        header h1 { 
            font-size: 3rem; 
            font-weight: 800; 
            margin-bottom: 0.5rem; 
            background: linear-gradient(135deg, #38bdf8, #818cf8); 
            -webkit-background-clip: text; 
            -webkit-text-fill-color: transparent; 
        }
        
        .search-container {
            width: 100%;
            max-width: 600px;
            margin-bottom: 3rem;
            display: flex;
            gap: 10px;
        }

        input { 
            flex: 1;
            padding: 12px 20px; 
            background: rgba(30, 41, 59, 0.8);
            border: 1px solid rgba(255, 255, 255, 0.1); 
            border-radius: 8px; 
            color: #f8fafc;
            font-size: 1rem;
            transition: all 0.3s ease;
        }
        
        input:focus {
            outline: none;
            border-color: #38bdf8;
            box-shadow: 0 0 0 2px rgba(56, 189, 248, 0.2);
        }

        button.btn-primary { 
            background: linear-gradient(135deg, #38bdf8, #818cf8);
            color: #0f172a; 
            font-weight: 700;
            padding: 12px 24px; 
            border: none; 
            border-radius: 8px; 
            cursor: pointer; 
            font-size: 1rem; 
            transition: opacity 0.3s ease;
        }

        button.btn-primary:hover { opacity: 0.9; }

        /* Layout Container */
        .collection-container { 
            display: flex; 
            gap: 2rem; 
            max-width: 1200px; 
            width: 100%; 
            justify-content: center; 
            flex-wrap: wrap; 
        }

        /* Card Styling */
        .card { 
            background: rgba(30, 41, 59, 0.8); 
            border: 1px solid rgba(255, 255, 255, 0.1); 
            border-radius: 16px; 
            padding: 2rem; 
            width: 320px; 
            text-align: center; 
            color: #f1f5f9; 
            transition: all 0.3s ease; 
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); 
        }
        .card:hover { 
            transform: translateY(-8px); 
            background: rgba(30, 41, 59, 1); 
            box-shadow: 0 20px 25px rgba(0, 0, 0, 0.2); 
            border-color: rgba(255, 255, 255, 0.2); 
        }

        .card h2 { font-size: 1.5rem; margin-bottom: 0.5rem; color: #38bdf8; }
        .card p { color: #94a3b8; font-size: 0.95rem; margin-bottom: 0.5rem; }
        .card .meta { font-size: 0.9rem; color: #818cf8; margin-bottom: 1.5rem; font-weight: 600; }

        /* Action Buttons */
        .card-actions { display: flex; justify-content: center; gap: 1rem; }
        .btn {
            padding: 0.5rem 1.25rem;
            border-radius: 8px;
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 600;
            transition: background 0.3s ease;
        }
        .btn-edit { background-color: rgba(56, 189, 248, 0.2); color: #38bdf8; border: 1px solid #38bdf8; }
        .btn-edit:hover { background-color: #38bdf8; color: #0f172a; }
        .btn-delete { background-color: rgba(239, 68, 68, 0.2); color: #f87171; border: 1px solid #f87171; }
        .btn-delete:hover { background-color: #f87171; color: #0f172a; }

        .back-link { color: #94a3b8; text-decoration: none; margin-top: 10px; display: inline-block; }
        .back-link:hover { color: #38bdf8; }
        .no-results { color: #f87171; font-size: 1.2rem; margin-top: 2rem; }

    </style>
</head>
<body>

    <header>
        <h1>Search Vault</h1>
        <a href="/" class="back-link">← Back to Home</a>
    </header>

    <form action="/search" method="GET" class="search-container">
        <input type="text" name="q" placeholder="Enter movie title..." value="<%= locals.searchQuery ? searchQuery : '' %>" required>
        <button type="submit" class="btn-primary">Search</button>
    </form>

    <div class="collection-container">
        <% if (locals.searchResults && searchResults.length > 0) { %>
            <% searchResults.forEach((element) => { %>
                <div class="card">
                    <h2><%= element.movieName %></h2>
                    <p><strong>Director:</strong> <%= element.director %></p>
                    <p><strong>Genre:</strong> <%= element.genre %></p>
                    <p class="meta"><%= element.releaseYear %> | ★ <%= element.rating %></p>
                    
                    <div class="card-actions">
                        <a href="/edit/<%= element._id %>" class="btn btn-edit">Edit</a>
                        <a href="/delete/<%= element._id %>" class="btn btn-delete">Delete</a>
                    </div>
                </div>
            <% }) %>
        <% } else if (locals.searchQuery) { %>
            <p class="no-results">No movies found matching "<%= searchQuery %>". Try another title!</p>
        <% } %>
    </div>

</body>
</html>